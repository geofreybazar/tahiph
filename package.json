{
  "name": "tahi",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.11 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run generate -w @tahi/database",
    "db:migrate:dev": "npm run migrate:dev -w @tahi/database",
    "db:migrate:deploy": "npm run migrate:deploy -w @tahi/database",
    "db:drift": "npm run drift -w @tahi/database"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "@swc/core@1.16.22": true,
    "msgpackr-extract": false
  }
}
