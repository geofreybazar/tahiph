generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  active
  inactive
  suspended

  @@map("tenant_status")
}

enum TenantRole {
  owner
  admin
  staff

  @@map("tenant_role")
}

enum MembershipStatus {
  active
  removed

  @@map("membership_status")
}

enum MediaBucket {
  public_media
  private_media

  @@map("media_bucket")
}

enum MediaPurpose {
  sketch
  design_reference
  fitting_photo
  payment_proof
  expense_receipt

  @@map("media_purpose")
}

enum MediaStatus {
  pending
  ready

  @@map("media_status")
}

enum ProjectStatus {
  draft
  active
  completed
  cancelled

  @@map("project_status")
}

enum GarmentStage {
  design
  fabric_sourcing
  cutting
  sewing
  embellishment
  fitting
  alterations
  ready
  released

  @@map("garment_stage")
}

enum WearerRole {
  bride
  groom
  entourage
  other

  @@map("wearer_role")
}

enum MeasurementUnit {
  in
  cm

  @@map("measurement_unit")
}

// ---------- Global models ----------

model Tenant {
  id        String       @id @default(uuid(7)) @db.Uuid
  slug      String       @unique
  name      String
  status    TenantStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  memberships          TenantMembership[]
  invitations          TenantInvitation[]
  mediaFiles           MediaFile[]
  documentCounters     DocumentCounter[]
  clients              Client[]
  weddingProjects      WeddingProject[]
  garments             Garment[]
  garmentEvents        GarmentStageEvent[]
  garmentMedia         GarmentMedia[]
  paymentScheduleItems PaymentScheduleItem[]
  measurementProfiles  MeasurementProfile[]
  measurementRecords   MeasurementRecord[]
  measurementValues    MeasurementValue[]

  @@map("tenants")
}

model User {
  /// Equals the Supabase Auth `sub`; never generated here.
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  memberships          TenantMembership[]
  invitationsSent      TenantInvitation[]
  mediaUploaded        MediaFile[]
  stageChanges         GarmentStageEvent[]
  measurementsRecorded MeasurementRecord[]
  platformAdmin        PlatformAdmin?

  @@map("users")
}

model PlatformAdmin {
  userId    String   @id @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("platform_admins")
}

/// Has a nullable tenant_id for platform-level events, so it's a named registry exception.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------- Tenant-owned models ----------

model TenantMembership {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      TenantRole
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

model TenantInvitation {
  id              String     @id @default(uuid(7)) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  email           String
  role            TenantRole
  tokenHash       String     @unique @map("token_hash")
  expiresAt       DateTime   @map("expires_at") @db.Timestamptz
  acceptedAt      DateTime?  @map("accepted_at") @db.Timestamptz
  invitedByUserId String     @map("invited_by_user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedBy User   @relation(fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("tenant_invitations")
}

model MediaFile {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  bucket           MediaBucket
  objectKey        String       @map("object_key")
  purpose          MediaPurpose
  mimeType         String       @map("mime_type")
  sizeBytes        Int          @map("size_bytes")
  originalFilename String?      @map("original_filename")
  status           MediaStatus  @default(pending)
  uploadedByUserId String       @map("uploaded_by_user_id") @db.Uuid
  expiresAt        DateTime?    @map("expires_at") @db.Timestamptz
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  uploadedBy User   @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  garmentLink GarmentMedia?

  @@unique([tenantId, id])
  @@unique([bucket, objectKey])
  @@index([tenantId, status])
  @@map("media_files")
}

model DocumentCounter {
  tenantId String @map("tenant_id") @db.Uuid
  key      String
  value    BigInt @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, key])
  @@map("document_counters")
}

model Client {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  fullName   String    @map("full_name")
  email      String?
  phone      String?
  notes      String?
  archivedAt DateTime? @map("archived_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  projects            WeddingProject[]
  measurementProfiles MeasurementProfile[]

  @@unique([tenantId, id])
  @@index([tenantId, fullName])
  @@index([tenantId, email])
  @@map("clients")
}

model WeddingProject {
  id            String        @id @default(uuid(7)) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  clientId      String        @map("client_id") @db.Uuid
  projectNumber String        @map("project_number")
  title         String
  weddingDate   DateTime?     @map("wedding_date") @db.Date
  status        ProjectStatus @default(draft)
  priceCentavos Int           @map("price_centavos")
  notes         String?
  archivedAt    DateTime?     @map("archived_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client Client @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)

  garments             Garment[]
  paymentScheduleItems PaymentScheduleItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectNumber])
  @@index([tenantId, clientId])
  @@index([tenantId, status])
  @@index([tenantId, weddingDate])
  @@map("wedding_projects")
}

model Garment {
  id                  String       @id @default(uuid(7)) @db.Uuid
  tenantId            String       @map("tenant_id") @db.Uuid
  projectId           String       @map("project_id") @db.Uuid
  name                String
  wearerName          String       @map("wearer_name")
  wearerRole          WearerRole   @map("wearer_role")
  description         String?
  stage               GarmentStage @default(design)
  measurementRecordId String?      @map("measurement_record_id") @db.Uuid
  dueDate             DateTime?    @map("due_date") @db.Date
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project           WeddingProject      @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  events            GarmentStageEvent[]
  media             GarmentMedia[]
  measurementRecord MeasurementRecord?  @relation(fields: [tenantId, measurementRecordId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, projectId])
  @@index([tenantId, stage])
  @@index([tenantId, measurementRecordId])
  @@map("garments")
}

/// Append-only: every stage change, including going backward.
model GarmentStageEvent {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  garmentId       String        @map("garment_id") @db.Uuid
  fromStage       GarmentStage? @map("from_stage")
  toStage         GarmentStage  @map("to_stage")
  changedByUserId String        @map("changed_by_user_id") @db.Uuid
  note            String?
  occurredAt      DateTime      @default(now()) @map("occurred_at") @db.Timestamptz

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  garment   Garment @relation(fields: [tenantId, garmentId], references: [tenantId, id], onDelete: Restrict)
  changedBy User    @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, garmentId, occurredAt])
  @@map("garment_stage_events")
}

model MeasurementProfile {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  personName    String    @map("person_name")
  notes         String?
  portalVisible Boolean   @default(false) @map("portal_visible")
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client  Client              @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  records MeasurementRecord[]

  @@unique([tenantId, id])
  @@index([tenantId, clientId])
  @@map("measurement_profiles")
}

/// Never edited after creation: a correction is a new record.
model MeasurementRecord {
  id               String          @id @default(uuid(7)) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  profileId        String          @map("profile_id") @db.Uuid
  takenOn          DateTime        @map("taken_on") @db.Date
  unit             MeasurementUnit
  notes            String?
  recordedByUserId String          @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  profile    MeasurementProfile @relation(fields: [tenantId, profileId], references: [tenantId, id], onDelete: Restrict)
  recordedBy User               @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)
  values     MeasurementValue[]
  garments   Garment[]

  @@unique([tenantId, id])
  @@index([tenantId, profileId, takenOn(sort: Desc)])
  @@map("measurement_records")
}

model MeasurementValue {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  recordId String  @map("record_id") @db.Uuid
  key      String
  label    String?
  value    Decimal @db.Decimal(6, 2)

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  record MeasurementRecord @relation(fields: [tenantId, recordId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, recordId, key])
  @@map("measurement_values")
}

/// A file belongs to one garment, so removing it from the garment can delete the file.
model GarmentMedia {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  garmentId   String   @map("garment_id") @db.Uuid
  mediaFileId String   @map("media_file_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  garment   Garment   @relation(fields: [tenantId, garmentId], references: [tenantId, id], onDelete: Restrict)
  mediaFile MediaFile @relation(fields: [tenantId, mediaFileId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, mediaFileId])
  @@index([tenantId, garmentId])
  @@map("garment_media")
}

/// The planned payments for a project. Their total may differ from the price: prices change.
model PaymentScheduleItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  label          String
  dueDate        DateTime @map("due_date") @db.Date
  amountCentavos Int      @map("amount_centavos")
  sortOrder      Int      @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project WeddingProject @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, projectId])
  @@map("payment_schedule_items")
}
