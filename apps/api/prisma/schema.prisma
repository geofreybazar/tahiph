generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  active
  inactive
  suspended

  @@map("tenant_status")
}

enum TenantRole {
  owner
  admin
  staff

  @@map("tenant_role")
}

enum MembershipStatus {
  active
  removed

  @@map("membership_status")
}

enum MediaBucket {
  public_media
  private_media

  @@map("media_bucket")
}

enum MediaPurpose {
  sketch
  design_reference
  fitting_photo
  payment_proof
  expense_receipt

  @@map("media_purpose")
}

enum MediaStatus {
  pending
  ready

  @@map("media_status")
}

enum ProjectStatus {
  draft
  active
  completed
  cancelled

  @@map("project_status")
}

// ---------- Global models ----------

model Tenant {
  id        String       @id @default(uuid(7)) @db.Uuid
  slug      String       @unique
  name      String
  status    TenantStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  memberships      TenantMembership[]
  invitations      TenantInvitation[]
  mediaFiles       MediaFile[]
  documentCounters DocumentCounter[]
  clients          Client[]
  weddingProjects  WeddingProject[]

  @@map("tenants")
}

model User {
  /// Equals the Supabase Auth `sub`; never generated here.
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  memberships     TenantMembership[]
  invitationsSent TenantInvitation[]
  mediaUploaded   MediaFile[]
  platformAdmin   PlatformAdmin?

  @@map("users")
}

model PlatformAdmin {
  userId    String   @id @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("platform_admins")
}

/// Has a nullable tenant_id for platform-level events, so it's a named registry exception.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------- Tenant-owned models ----------

model TenantMembership {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      TenantRole
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

model TenantInvitation {
  id              String     @id @default(uuid(7)) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  email           String
  role            TenantRole
  tokenHash       String     @unique @map("token_hash")
  expiresAt       DateTime   @map("expires_at") @db.Timestamptz
  acceptedAt      DateTime?  @map("accepted_at") @db.Timestamptz
  invitedByUserId String     @map("invited_by_user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedBy User   @relation(fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("tenant_invitations")
}

model MediaFile {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  bucket           MediaBucket
  objectKey        String       @map("object_key")
  purpose          MediaPurpose
  mimeType         String       @map("mime_type")
  sizeBytes        Int          @map("size_bytes")
  originalFilename String?      @map("original_filename")
  status           MediaStatus  @default(pending)
  uploadedByUserId String       @map("uploaded_by_user_id") @db.Uuid
  expiresAt        DateTime?    @map("expires_at") @db.Timestamptz
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  uploadedBy User   @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([bucket, objectKey])
  @@index([tenantId, status])
  @@map("media_files")
}

model DocumentCounter {
  tenantId String @map("tenant_id") @db.Uuid
  key      String
  value    BigInt @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, key])
  @@map("document_counters")
}

model Client {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  fullName   String    @map("full_name")
  email      String?
  phone      String?
  notes      String?
  archivedAt DateTime? @map("archived_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  projects WeddingProject[]

  @@unique([tenantId, id])
  @@index([tenantId, fullName])
  @@index([tenantId, email])
  @@map("clients")
}

model WeddingProject {
  id            String        @id @default(uuid(7)) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  clientId      String        @map("client_id") @db.Uuid
  projectNumber String        @map("project_number")
  title         String
  weddingDate   DateTime?     @map("wedding_date") @db.Date
  status        ProjectStatus @default(draft)
  priceCentavos Int           @map("price_centavos")
  notes         String?
  archivedAt    DateTime?     @map("archived_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client Client @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, projectNumber])
  @@index([tenantId, clientId])
  @@index([tenantId, status])
  @@index([tenantId, weddingDate])
  @@map("wedding_projects")
}
