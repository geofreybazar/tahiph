{
  "name": "@tahi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile main.worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/main.worker.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration"
  },
  "dependencies": {
    "@nestjs/bullmq": "12.0.1",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@tahi/database": "*",
    "@tahi/types": "*",
    "@tahi/validation": "*",
    "bullmq": "6.7.3",
    "ioredis": "6.0.0",
    "nestjs-cls": "7.0.2",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.2",
    "@swc/core": "1.16.22",
    "@tahi/config": "*",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "unplugin-swc": "2.0.0"
  }
}
