# Copy to apps/api/.env for local development. Placeholders only — never commit real values.
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=debug
# Local Docker Compose (docker-compose.yml). The app connects as the least-privilege role.
DATABASE_URL=postgresql://tahi_app:change-me-app@127.0.0.1:5432/tahi
REDIS_URL=redis://:change-me-redis@127.0.0.1:6379/0
# Comma-separated proxy hops/subnets Express should trust for X-Forwarded-* (Traefik in prod).
TRUST_PROXY=loopback
# Hosts that select the realm (docs/MULTI_TENANCY.md §3). *.localhost resolves to 127.0.0.1.
APP_HOST=app.localhost
ADMIN_HOST=admin.localhost
API_HOST=api.localhost
STOREFRONT_ROOT_DOMAIN=localhost
# Dashboard origin used in email links (the Next.js dev server).
APP_PUBLIC_URL=http://app.localhost:3001
# TRIAL (self-serve) or PENDING_APPROVAL (open question Q6).
TENANT_ONBOARDING_STATUS=TRIAL
# Email: log | mailpit (local, docker-compose.yml) | resend (production)
EMAIL_TRANSPORT=mailpit
EMAIL_FROM=TAHI.ph <no-reply@tahi.local>
MAILPIT_URL=http://127.0.0.1:8025
# RESEND_API_KEY=only-in-production
