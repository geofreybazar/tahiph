{
  "name": "@tahi/types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript types inferred from @tahi/validation and cross-app enums.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tahi/validation": "*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tahi/config": "*"
  }
}
