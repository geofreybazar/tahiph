// TAHI.ph Prisma schema.
//
// Conventions (docs/DATABASE_DESIGN.md §1):
// - PascalCase models mapped to snake_case tables; UUIDv7 ids generated by the client.
// - Tenant-owned tables: tenant_id, UNIQUE(tenant_id, id), composite FKs (tenant_id, x_id),
//   tenant-leading indexes, and an enabled + forced RLS policy (raw SQL in the migration).
//   Every tenant-owned model must be listed in src/tenancy/tenant-models.ts; an integration
//   test fails if that list and the database's RLS tables differ.
// - Tenant-owned models are written with unchecked inputs (scalar FK fields), so the scoped
//   client can stamp tenantId.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum SessionRealm {
  PLATFORM
  TENANT
  CUSTOMER
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  DISABLED
}

enum PlatformUserRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
}

enum PlatformUserStatus {
  ACTIVE
  DISABLED
}

enum TenantStatus {
  PENDING_APPROVAL
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  ARCHIVED
}

enum TenantDomainType {
  SUBDOMAIN
  CUSTOM
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum AuthTokenPurpose {
  VERIFY_EMAIL
  PASSWORD_RESET
  INVITE
  CUSTOMER_OTP
}

enum CustomerAccountStatus {
  ACTIVE
  DISABLED
}

enum ActorType {
  PLATFORM_USER
  USER
  CUSTOMER
  SYSTEM
}

// ---------------------------------------------------------------------------
// Platform & identity (global, no RLS)
// ---------------------------------------------------------------------------

model PlatformUser {
  id            String             @id @default(uuid(7)) @db.Uuid
  email         String             @unique @db.Citext
  name          String
  passwordHash  String             @map("password_hash")
  role          PlatformUserRole
  status        PlatformUserStatus @default(ACTIVE)
  /// AES-256-GCM ciphertext of the TOTP secret (key id prefix allows rotation).
  mfaSecretEnc  Bytes?             @map("mfa_secret_enc")
  mfaEnrolledAt DateTime?          @map("mfa_enrolled_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step; a code is never accepted twice (replay protection).
  mfaLastStep   BigInt?            @map("mfa_last_step")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  recoveryCodes PlatformRecoveryCode[]

  @@map("platform_user")
}

/// Single-use MFA recovery codes (SHA-256 hashes only), issued at TOTP enrollment.
model PlatformRecoveryCode {
  id             String    @id @default(uuid(7)) @db.Uuid
  platformUserId String    @map("platform_user_id") @db.Uuid
  codeHash       Bytes     @unique @map("code_hash")
  usedAt         DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@map("platform_recovery_code")
}

/// Tenant staff identity: one per person, may belong to several tenants.
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String     @unique @db.Citext
  name            String
  passwordHash    String     @map("password_hash")
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships TenantMembership[]

  @@map("user")
}

/// Opaque sessions for all realms. Only the SHA-256 of the token is stored.
model Session {
  id                 String       @id @default(uuid(7)) @db.Uuid
  tokenHash          Bytes        @unique @map("token_hash")
  realm              SessionRealm
  /// User (TENANT), PlatformUser (PLATFORM) or CustomerAccount (CUSTOMER) id.
  subjectId          String       @map("subject_id") @db.Uuid
  /// TENANT: tenant of the active membership. CUSTOMER: the tenant the session is bound to.
  tenantId           String?      @map("tenant_id") @db.Uuid
  activeMembershipId String?      @map("active_membership_id") @db.Uuid
  /// PLATFORM: set once the TOTP step completes. Platform routes require it.
  mfaVerifiedAt      DateTime?    @map("mfa_verified_at") @db.Timestamptz(3)
  ip                 String?      @db.Inet
  userAgent          String?      @map("user_agent")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt         DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Sliding idle expiry, extended on use.
  expiresAt          DateTime     @map("expires_at") @db.Timestamptz(3)
  /// Hard cap from creation; never extended.
  absoluteExpiresAt  DateTime     @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt          DateTime?    @map("revoked_at") @db.Timestamptz(3)

  @@index([subjectId, revokedAt])
  @@index([expiresAt])
  @@map("session")
}

/// Single-use tokens: email verification, password reset, invitations, customer OTP.
model AuthToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  tokenHash Bytes            @unique @map("token_hash")
  purpose   AuthTokenPurpose
  subjectId String?          @map("subject_id") @db.Uuid
  tenantId  String?          @map("tenant_id") @db.Uuid
  email     String?          @db.Citext
  /// Purpose-specific data, e.g. { roleId } for INVITE. Validated with Zod where read.
  metadata  Json?
  attempts  Int              @default(0)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([purpose, subjectId])
  @@index([expiresAt])
  @@map("auth_token")
}

// ---------------------------------------------------------------------------
// Tenant registry (no RLS; read through dedicated endpoints)
// ---------------------------------------------------------------------------

model Tenant {
  id        String       @id @default(uuid(7)) @db.Uuid
  slug      String       @unique @db.Citext
  name      String
  status    TenantStatus @default(PENDING_APPROVAL)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  domains          TenantDomain[]
  memberships      TenantMembership[]
  roles            Role[]
  auditLogs        TenantAuditLog[]
  customerAccounts CustomerAccount[]

  @@map("tenant")
}

model TenantDomain {
  id         String           @id @default(uuid(7)) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  /// Lower-case hostname without port, e.g. "maria.tahi.ph".
  hostname   String           @unique @db.Citext
  type       TenantDomainType
  isPrimary  Boolean          @default(false) @map("is_primary")
  verifiedAt DateTime?        @map("verified_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("tenant_domain")
}

// ---------------------------------------------------------------------------
// Tenant-owned (RLS, FORCE)
// ---------------------------------------------------------------------------

model Role {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Stable key: "owner", "admin", "designer", "tailor", "staff" for system roles.
  key       String
  name      String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  memberships TenantMembership[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("role")
}

model RolePermission {
  tenantId   String @map("tenant_id") @db.Uuid
  roleId     String @map("role_id") @db.Uuid
  /// Code-defined permission string (packages/types permissions.ts).
  permission String

  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([tenantId, roleId])
  @@map("role_permission")
}

model TenantMembership {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  status    MembershipStatus @default(INVITED)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([tenantId, roleId])
  @@index([userId])
  @@map("tenant_membership")
}

/// A storefront customer of one atelier (passwordless email OTP). Per-tenant identity: the
/// same person at two ateliers has two unrelated accounts (Data Privacy Act).
/// Linked to the CRM Client in Phase 3 (additive clientId + composite FK).
model CustomerAccount {
  id              String                @id @default(uuid(7)) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  email           String                @db.Citext
  name            String?
  status          CustomerAccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime              @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?             @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@map("customer_account")
}

/// Append-only (UPDATE/DELETE blocked by trigger).
model TenantAuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  action     String
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id") @db.Uuid
  ip         String?   @db.Inet
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("tenant_audit_log")
}

// ---------------------------------------------------------------------------
// Platform audit (global, append-only)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  action     String
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id") @db.Uuid
  tenantId   String?   @map("tenant_id") @db.Uuid
  ip         String?   @db.Inet
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_log")
}
