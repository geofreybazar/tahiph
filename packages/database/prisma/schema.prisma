// TAHI.ph Prisma schema.
//
// Conventions (docs/DATABASE_DESIGN.md §1):
// - PascalCase models mapped to snake_case tables; UUIDv7 ids generated by the client.
// - Tenant-owned tables: tenant_id, UNIQUE(tenant_id, id), composite FKs (tenant_id, x_id),
//   tenant-leading indexes, and an enabled + forced RLS policy (raw SQL in the migration).
//   Every tenant-owned model must be listed in src/tenancy/tenant-models.ts; an integration
//   test fails if that list and the database's RLS tables differ.
// - Tenant-owned models are written with unchecked inputs (scalar FK fields), so the scoped
//   client can stamp tenantId.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum SessionRealm {
  PLATFORM
  TENANT
  CUSTOMER
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  DISABLED
}

enum PlatformUserRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
}

enum PlatformUserStatus {
  ACTIVE
  DISABLED
}

enum TenantStatus {
  PENDING_APPROVAL
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  ARCHIVED
}

enum TenantDomainType {
  SUBDOMAIN
  CUSTOM
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum AuthTokenPurpose {
  VERIFY_EMAIL
  PASSWORD_RESET
  INVITE
  CUSTOMER_OTP
}

enum CustomerAccountStatus {
  ACTIVE
  DISABLED
}

enum ClientSource {
  WALK_IN
  REFERRAL
  STOREFRONT
  SOCIAL
  OTHER
}

enum CommunicationChannel {
  CALL
  SMS
  EMAIL
  MESSENGER
  VIBER
  IN_PERSON
  OTHER
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum AppointmentKind {
  CONSULTATION
  MEASUREMENT
  DESIGN
  FITTING
  FINAL_FITTING
  PICKUP
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  DASHBOARD
  STOREFRONT
}

enum CatalogItemKind {
  PRODUCT
  SERVICE
}

enum Fulfilment {
  READY_TO_WEAR
  MADE_TO_MEASURE
}

enum PricingMode {
  FIXED
  QUOTE
}

enum OptionSelection {
  SINGLE
  MULTIPLE
}

/// Default unit for new measurement records (Q2). Each record also stores its own unit.
enum MeasurementUnit {
  CM
  IN
}

enum ActorType {
  PLATFORM_USER
  USER
  CUSTOMER
  SYSTEM
}

// ---------------------------------------------------------------------------
// Platform & identity (global, no RLS)
// ---------------------------------------------------------------------------

model PlatformUser {
  id            String             @id @default(uuid(7)) @db.Uuid
  email         String             @unique @db.Citext
  name          String
  passwordHash  String             @map("password_hash")
  role          PlatformUserRole
  status        PlatformUserStatus @default(ACTIVE)
  /// AES-256-GCM ciphertext of the TOTP secret (key id prefix allows rotation).
  mfaSecretEnc  Bytes?             @map("mfa_secret_enc")
  mfaEnrolledAt DateTime?          @map("mfa_enrolled_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step; a code is never accepted twice (replay protection).
  mfaLastStep   BigInt?            @map("mfa_last_step")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  recoveryCodes PlatformRecoveryCode[]

  @@map("platform_user")
}

/// Single-use MFA recovery codes (SHA-256 hashes only), issued at TOTP enrollment.
model PlatformRecoveryCode {
  id             String    @id @default(uuid(7)) @db.Uuid
  platformUserId String    @map("platform_user_id") @db.Uuid
  codeHash       Bytes     @unique @map("code_hash")
  usedAt         DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@map("platform_recovery_code")
}

/// Tenant staff identity: one per person, may belong to several tenants.
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String     @unique @db.Citext
  name            String
  passwordHash    String     @map("password_hash")
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships TenantMembership[]

  @@map("user")
}

/// Opaque sessions for all realms. Only the SHA-256 of the token is stored.
model Session {
  id                 String       @id @default(uuid(7)) @db.Uuid
  tokenHash          Bytes        @unique @map("token_hash")
  realm              SessionRealm
  /// User (TENANT), PlatformUser (PLATFORM) or CustomerAccount (CUSTOMER) id.
  subjectId          String       @map("subject_id") @db.Uuid
  /// TENANT: tenant of the active membership. CUSTOMER: the tenant the session is bound to.
  tenantId           String?      @map("tenant_id") @db.Uuid
  activeMembershipId String?      @map("active_membership_id") @db.Uuid
  /// PLATFORM: set once the TOTP step completes. Platform routes require it.
  mfaVerifiedAt      DateTime?    @map("mfa_verified_at") @db.Timestamptz(3)
  ip                 String?      @db.Inet
  userAgent          String?      @map("user_agent")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt         DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Sliding idle expiry, extended on use.
  expiresAt          DateTime     @map("expires_at") @db.Timestamptz(3)
  /// Hard cap from creation; never extended.
  absoluteExpiresAt  DateTime     @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt          DateTime?    @map("revoked_at") @db.Timestamptz(3)

  @@index([subjectId, revokedAt])
  @@index([expiresAt])
  @@map("session")
}

/// Single-use tokens: email verification, password reset, invitations, customer OTP.
model AuthToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  tokenHash Bytes            @unique @map("token_hash")
  purpose   AuthTokenPurpose
  subjectId String?          @map("subject_id") @db.Uuid
  tenantId  String?          @map("tenant_id") @db.Uuid
  email     String?          @db.Citext
  /// Purpose-specific data, e.g. { roleId } for INVITE. Validated with Zod where read.
  metadata  Json?
  attempts  Int              @default(0)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([purpose, subjectId])
  @@index([expiresAt])
  @@map("auth_token")
}

// ---------------------------------------------------------------------------
// Tenant registry (no RLS; read through dedicated endpoints)
// ---------------------------------------------------------------------------

model Tenant {
  id        String       @id @default(uuid(7)) @db.Uuid
  slug      String       @unique @db.Citext
  name      String
  status    TenantStatus @default(PENDING_APPROVAL)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  domains           TenantDomain[]
  memberships       TenantMembership[]
  roles             Role[]
  auditLogs         TenantAuditLog[]
  customerAccounts  CustomerAccount[]
  businessProfile   BusinessProfile?
  settings          TenantSettings?
  operatingHours    OperatingHours[]
  holidays          Holiday[]
  clients           Client[]
  garmentCategories GarmentCategory[]
  appointmentTypes  AppointmentType[]
  catalogCategories CatalogCategory[]
  catalogItems      CatalogItem[]
  optionGroups      CatalogOptionGroup[]
  mediaAssets       MediaAsset[]

  @@map("tenant")
}

model TenantDomain {
  id         String           @id @default(uuid(7)) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  /// Lower-case hostname without port, e.g. "maria.tahi.ph".
  hostname   String           @unique @db.Citext
  type       TenantDomainType
  isPrimary  Boolean          @default(false) @map("is_primary")
  verifiedAt DateTime?        @map("verified_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("tenant_domain")
}

// ---------------------------------------------------------------------------
// Tenant-owned (RLS, FORCE)
// ---------------------------------------------------------------------------

model Role {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Stable key: "owner", "admin", "designer", "tailor", "staff" for system roles.
  key       String
  name      String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  memberships TenantMembership[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("role")
}

model RolePermission {
  tenantId   String @map("tenant_id") @db.Uuid
  roleId     String @map("role_id") @db.Uuid
  /// Code-defined permission string (packages/types permissions.ts).
  permission String

  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([tenantId, roleId])
  @@map("role_permission")
}

model TenantMembership {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  status    MembershipStatus @default(INVITED)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  clientNotes        ClientNote[]
  communications     Communication[]
  measurementRecords MeasurementRecord[]
  staffAvailability  StaffAvailability[]
  timeOff            StaffTimeOff[]
  appointments       Appointment[]
  mediaAssets        MediaAsset[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([tenantId, roleId])
  @@index([userId])
  @@map("tenant_membership")
}

/// A storefront customer of one atelier (passwordless email OTP). Per-tenant identity: the
/// same person at two ateliers has two unrelated accounts (Data Privacy Act).
/// Linked to the CRM Client in Phase 3 (additive clientId + composite FK).
model CustomerAccount {
  id              String                @id @default(uuid(7)) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  email           String                @db.Citext
  name            String?
  status          CustomerAccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime              @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?             @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@map("customer_account")
}

/// Append-only (UPDATE/DELETE blocked by trigger).
model TenantAuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  action     String
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id") @db.Uuid
  ip         String?   @db.Inet
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("tenant_audit_log")
}

// ---------------------------------------------------------------------------
// Platform audit (global, append-only)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  action     String
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id") @db.Uuid
  tenantId   String?   @map("tenant_id") @db.Uuid
  ip         String?   @db.Inet
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Atelier profile and settings (tenant-owned, RLS). One profile and one settings row per
// tenant, created at onboarding (ADR-024).
// ---------------------------------------------------------------------------

model BusinessProfile {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @unique @map("tenant_id") @db.Uuid
  displayName  String   @map("display_name")
  legalName    String?  @map("legal_name")
  /// Philippine Taxpayer Identification Number, as entered.
  tin          String?
  addressLine1 String?  @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String?
  province     String?
  postalCode   String?  @map("postal_code")
  phone        String?
  email        String?  @db.Citext
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("business_profile")
}

model TenantSettings {
  id                   String          @id @default(uuid(7)) @db.Uuid
  tenantId             String          @unique @map("tenant_id") @db.Uuid
  /// IANA time zone; dates and opening hours are interpreted in it.
  timezone             String          @default("Asia/Manila")
  currency             String          @default("PHP") @db.Char(3)
  measurementUnit      MeasurementUnit @default(CM) @map("measurement_unit")
  vatRegistered        Boolean         @default(false) @map("vat_registered")
  /// Percentage, e.g. 12.00 for 12% VAT.
  taxRate              Decimal         @default(0) @map("tax_rate") @db.Decimal(5, 2)
  pricesIncludeTax     Boolean         @default(true) @map("prices_include_tax")
  /// Email clients a reminder up to 24 hours before appointments (ADR-029).
  appointmentReminders Boolean         @default(true) @map("appointment_reminders")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("tenant_settings")
}

/// One opening range on a weekday; a day can have several (e.g. split lunch). Minutes since
/// local midnight in the tenant's timezone. Replaced as a whole week by the API.
model OperatingHours {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// 0 = Sunday … 6 = Saturday.
  dayOfWeek    Int      @map("day_of_week") @db.SmallInt
  opensMinute  Int      @map("opens_minute") @db.SmallInt
  closesMinute Int      @map("closes_minute") @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, dayOfWeek])
  @@map("operating_hours")
}

/// A closed day, interpreted in the tenant's timezone.
model Holiday {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, date])
  @@map("holiday")
}

// ---------------------------------------------------------------------------
// CRM (tenant-owned, RLS). Clients are archived, never deleted (DATABASE_DESIGN.md §5).
// ---------------------------------------------------------------------------

model Client {
  id           String       @id @default(uuid(7)) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  firstName    String       @map("first_name")
  lastName     String?      @map("last_name")
  /// Not unique: family members often share one email.
  email        String?      @db.Citext
  phone        String?
  birthday     DateTime?    @db.Date
  addressLine1 String?      @map("address_line1")
  addressLine2 String?      @map("address_line2")
  city         String?
  province     String?
  postalCode   String?      @map("postal_code")
  /// Free-text style and fit preferences.
  preferences  String?
  source       ClientSource @default(OTHER)
  /// Lower-case, deduplicated by the API.
  tags         String[]     @default([])
  archivedAt   DateTime?    @map("archived_at") @db.Timestamptz(3)
  /// Set by a data-subject erasure (ADR-032): PII cleared, row kept as a pseudonymous
  /// reference. Erased clients are not found by the API.
  erasedAt     DateTime?    @map("erased_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  notes              ClientNote[]
  communications     Communication[]
  measurementRecords MeasurementRecord[]
  appointments       Appointment[]

  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "client_first_name_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "client_last_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "client_phone_trgm_idx")
  @@index([tags], type: Gin)
  @@map("client")
}

/// Internal note on a client. Never edited; the author may delete it.
model ClientNote {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  clientId           String   @map("client_id") @db.Uuid
  authorMembershipId String   @map("author_membership_id") @db.Uuid
  body               String
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  client Client           @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  author TenantMembership @relation(fields: [tenantId, authorMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, clientId, createdAt(sort: Desc)])
  @@index([tenantId, authorMembershipId])
  @@map("client_note")
}

/// A logged interaction with a client (call, message, visit).
model Communication {
  id                     String                 @id @default(uuid(7)) @db.Uuid
  tenantId               String                 @map("tenant_id") @db.Uuid
  clientId               String                 @map("client_id") @db.Uuid
  channel                CommunicationChannel
  direction              CommunicationDirection
  summary                String
  occurredAt             DateTime               @map("occurred_at") @db.Timestamptz(3)
  recordedByMembershipId String                 @map("recorded_by_membership_id") @db.Uuid
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  client     Client           @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  recordedBy TenantMembership @relation(fields: [tenantId, recordedByMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, clientId, occurredAt(sort: Desc)])
  @@index([tenantId, recordedByMembershipId])
  @@map("communication")
}

// ---------------------------------------------------------------------------
// Measurements (tenant-owned, RLS). Templates are versioned; templates, fields, records and
// values are immutable (trigger), so history is never rewritten (ADR-027).
// ---------------------------------------------------------------------------

model GarmentCategory {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  templates MeasurementTemplate[]

  @@unique([tenantId, id])
  @@index([tenantId, name])
  @@map("garment_category")
}

/// One version of a category's form. The current template is the highest version.
model MeasurementTemplate {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  version    Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  category GarmentCategory     @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  fields   MeasurementField[]
  records  MeasurementRecord[]

  @@unique([tenantId, id])
  @@unique([tenantId, categoryId, version])
  @@map("measurement_template")
}

model MeasurementField {
  id         String  @id @default(uuid(7)) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  templateId String  @map("template_id") @db.Uuid
  /// Stable within a template, e.g. "suit.sleeve_length".
  key        String
  label      String
  /// Optional group heading on the form, e.g. "Trouser".
  section    String?
  sortOrder  Int     @map("sort_order")
  required   Boolean @default(false)

  template MeasurementTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, templateId, key])
  @@map("measurement_field")
}

/// A set of measurements taken once. Corrections are new records that supersede this one.
model MeasurementRecord {
  id                  String          @id @default(uuid(7)) @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  clientId            String          @map("client_id") @db.Uuid
  templateId          String          @map("template_id") @db.Uuid
  unit                MeasurementUnit
  /// "Measurement for" on paper forms, e.g. "Wedding, groom".
  measuredFor         String?         @map("measured_for")
  takenAt             DateTime        @map("taken_at") @db.Timestamptz(3)
  takenByMembershipId String          @map("taken_by_membership_id") @db.Uuid
  notes               String?
  supersedesId        String?         @map("supersedes_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  client       Client              @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  template     MeasurementTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Restrict)
  takenBy      TenantMembership    @relation(fields: [tenantId, takenByMembershipId], references: [tenantId, id], onDelete: Restrict)
  supersedes   MeasurementRecord?  @relation("Supersedes", fields: [tenantId, supersedesId], references: [tenantId, id], onDelete: Restrict)
  supersededBy MeasurementRecord?  @relation("Supersedes")
  values       MeasurementValue[]

  @@unique([tenantId, id])
  /// A record is corrected at most once, so history is a single chain.
  @@unique([tenantId, supersedesId])
  @@index([tenantId, clientId, takenAt(sort: Desc)])
  @@index([tenantId, templateId])
  @@index([tenantId, takenByMembershipId])
  @@map("measurement_record")
}

model MeasurementValue {
  tenantId String  @map("tenant_id") @db.Uuid
  recordId String  @map("record_id") @db.Uuid
  fieldKey String  @map("field_key")
  /// numeric(7,3): 1/8" (0.125) is exact.
  value    Decimal @db.Decimal(7, 3)

  record MeasurementRecord @relation(fields: [tenantId, recordId], references: [tenantId, id], onDelete: Restrict)

  @@id([recordId, fieldKey])
  @@index([tenantId, recordId])
  @@map("measurement_value")
}

// ---------------------------------------------------------------------------
// Appointments (tenant-owned, RLS). Booked per staff member (Q1); an exclusion constraint
// prevents overlaps (DATABASE_DESIGN.md §3.1, ADR-028).
// ---------------------------------------------------------------------------

model AppointmentType {
  id              String          @id @default(uuid(7)) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  name            String
  kind            AppointmentKind
  durationMinutes Int             @map("duration_minutes")
  /// Kept free after the appointment (cleanup, notes); blocks the staff member's calendar.
  bufferMinutes   Int             @default(0) @map("buffer_minutes")
  /// Bookable on the storefront (Phase 5).
  publicBookable  Boolean         @default(false) @map("public_bookable")
  /// "#RRGGBB" for the calendar.
  color           String?
  archivedAt      DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@unique([tenantId, id])
  @@map("appointment_type")
}

/// Weekly working hours of a staff member, like OperatingHours. No rows: follows opening hours.
model StaffAvailability {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  dayOfWeek    Int      @map("day_of_week") @db.SmallInt
  opensMinute  Int      @map("opens_minute") @db.SmallInt
  closesMinute Int      @map("closes_minute") @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, membershipId, dayOfWeek])
  @@map("staff_availability")
}

model StaffTimeOff {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  startsAt     DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime @map("ends_at") @db.Timestamptz(3)
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, membershipId, startsAt])
  @@map("staff_time_off")
}

model Appointment {
  id                String            @id @default(uuid(7)) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  clientId          String            @map("client_id") @db.Uuid
  typeId            String            @map("type_id") @db.Uuid
  staffMembershipId String            @map("staff_membership_id") @db.Uuid
  startsAt          DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime          @map("ends_at") @db.Timestamptz(3)
  /// endsAt + the type's buffer: the end of the range the exclusion constraint protects.
  blockedUntil      DateTime          @map("blocked_until") @db.Timestamptz(3)
  status            AppointmentStatus @default(CONFIRMED)
  source            AppointmentSource @default(DASHBOARD)
  notes             String?
  cancelReason      String?           @map("cancel_reason")
  /// Set when the reminder email is queued; cleared on reschedule (ADR-029).
  reminderSentAt    DateTime?         @map("reminder_sent_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  client Client           @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  type   AppointmentType  @relation(fields: [tenantId, typeId], references: [tenantId, id], onDelete: Restrict)
  staff  TenantMembership @relation(fields: [tenantId, staffMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, startsAt])
  @@index([tenantId, clientId, startsAt(sort: Desc)])
  @@index([tenantId, staffMembershipId, startsAt])
  @@index([tenantId, typeId])
  @@map("appointment")
}

// ---------------------------------------------------------------------------
// Catalogue (tenant-owned, RLS). Archived, never deleted, so ids stay stable for the
// quotations and orders that snapshot them (ADR-030).
// ---------------------------------------------------------------------------

model CatalogCategory {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items  CatalogItem[]

  @@unique([tenantId, id])
  @@index([tenantId, sortOrder])
  @@map("catalog_category")
}

/// A product (ready-to-wear or made-to-measure) or a service, priced fixed or by quotation.
model CatalogItem {
  id            String          @id @default(uuid(7)) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  categoryId    String?         @map("category_id") @db.Uuid
  kind          CatalogItemKind
  name          String
  description   String?
  /// Products only.
  fulfilment    Fulfilment?
  pricingMode   PricingMode     @map("pricing_mode")
  /// Required when pricingMode is FIXED (CHECK).
  basePrice     Decimal?        @map("base_price") @db.Decimal(12, 2)
  currency      String          @default("PHP") @db.Char(3)
  /// Shown on the storefront (Phase 5).
  publicVisible Boolean         @default(false) @map("public_visible")
  archivedAt    DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category     CatalogCategory?         @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  optionGroups CatalogItemOptionGroup[]
  images       MediaAsset[]

  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, categoryId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "catalog_item_name_trgm_idx")
  @@map("catalog_item")
}

/// A reusable set of choices (e.g. Fabric), shared by many items.
model CatalogOptionGroup {
  id         String          @id @default(uuid(7)) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  name       String
  selection  OptionSelection
  required   Boolean         @default(false)
  archivedAt DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  options CatalogOption[]
  items   CatalogItemOptionGroup[]

  @@unique([tenantId, id])
  @@map("catalog_option_group")
}

model CatalogOption {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  groupId    String    @map("group_id") @db.Uuid
  name       String
  /// Added to the item price when chosen; may be negative (ADR-030).
  priceDelta Decimal   @default(0) @map("price_delta") @db.Decimal(12, 2)
  currency   String    @default("PHP") @db.Char(3)
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  group CatalogOptionGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, groupId, sortOrder])
  @@map("catalog_option")
}

/// Which option groups an item offers, in order. Replaced as a whole.
model CatalogItemOptionGroup {
  tenantId  String @map("tenant_id") @db.Uuid
  itemId    String @map("item_id") @db.Uuid
  groupId   String @map("group_id") @db.Uuid
  sortOrder Int    @map("sort_order")

  item  CatalogItem        @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  group CatalogOptionGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Restrict)

  @@id([itemId, groupId])
  @@index([tenantId, itemId])
  @@index([tenantId, groupId])
  @@map("catalog_item_option_group")
}

enum MediaPurpose {
  LOGO
  CATALOG_ITEM_IMAGE
}

/// PENDING: upload URL issued. PROCESSING: confirmed, worker re-encoding. READY: usable.
/// REJECTED: missing, too large or not a real image (ADR-031).
enum MediaStatus {
  PENDING
  PROCESSING
  READY
  REJECTED
}

/// An uploaded image. Objects live under t/{tenantId}/ in the bucket; keys derive from the id.
/// The original is deleted after re-encoding, so EXIF/GPS never persists (SECURITY.md).
model MediaAsset {
  id                    String       @id @default(uuid(7)) @db.Uuid
  tenantId              String       @map("tenant_id") @db.Uuid
  purpose               MediaPurpose
  status                MediaStatus  @default(PENDING)
  /// Declared by the client; the signed upload is bound to it.
  contentType           String       @map("content_type")
  /// Required for CATALOG_ITEM_IMAGE only (CHECK).
  catalogItemId         String?      @map("catalog_item_id") @db.Uuid
  createdByMembershipId String       @map("created_by_membership_id") @db.Uuid
  /// Pixel size of the display rendition, set when READY.
  width                 Int?
  height                Int?
  rejectReason          String?      @map("reject_reason")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  catalogItem CatalogItem?     @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Restrict)
  createdBy   TenantMembership @relation(fields: [tenantId, createdByMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, purpose, createdAt])
  @@index([tenantId, catalogItemId, createdAt])
  @@index([tenantId, createdByMembershipId])
  @@map("media_asset")
}
