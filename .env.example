# Root .env — consumed by docker-compose.yml (local) and docker-compose.prod.yml (VPS).
# Placeholders only. Never commit real values. Generate secrets with: openssl rand -base64 32

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
TAHI_OWNER_PASSWORD=change-me-owner
TAHI_APP_PASSWORD=change-me-app

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis

# --- Production only (docker-compose.prod.yml) -------------------------------
# Image tag deployed (git SHA), set by the deploy script.
TAG=main
# GHCR namespace, e.g. ghcr.io/<owner>
IMAGE_REGISTRY=ghcr.io/your-org
# Let's Encrypt account email and a Cloudflare API token scoped to Zone:DNS:Edit for tahi.ph only.
ACME_EMAIL=ops@example.com
CF_DNS_API_TOKEN=change-me
# Transactional email (Resend), sender on a verified domain.
RESEND_API_KEY=change-me
EMAIL_FROM=TAHI.ph <no-reply@tahi.ph>
# TRIAL or PENDING_APPROVAL for new ateliers.
TENANT_ONBOARDING_STATUS=TRIAL
# Secrets-at-rest key ring. Generate: echo "k1:$(openssl rand -base64 32)". Keep old keys when rotating.
ENCRYPTION_KEYS=k1:change-me
