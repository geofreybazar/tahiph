# Placeholders only. Copy to .env, which is git-ignored. Never commit real values.
# VITE_* and NEXT_PUBLIC_* reach the browser: never put a secret there.

# apps/api
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
# Local Supabase roles from supabase/roles.sql; these passwords are local only.
DATABASE_URL=postgresql://tahi_api:local_only_api@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://tahi_migrator:local_only_migrator@127.0.0.1:54322/postgres

# Local Supabase; on a hosted project use https://<project-ref>.supabase.co
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_URL=http://127.0.0.1:54321
ADMIN_APP_URL=http://localhost:5173
# From `npx supabase status`. Server only: never give this a VITE_ or NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=paste-secret-key-here

# apps/admin. The publishable key is from `npx supabase status`.
VITE_API_URL=http://localhost:4000/api/v1
VITE_SUPABASE_URL=http://127.0.0.1:54321
ADMIN_APP_URL=http://localhost:5173
VITE_SUPABASE_PUBLISHABLE_KEY=paste-publishable-key-here

# apps/web
API_URL=http://localhost:4000/api/v1
ROOT_DOMAIN=localhost:3000
